<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Installing updates downloaded from the project's GitHub releases; Android always asks first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Shoal takes over updates when it is installed. -->
    <queries>
        <package android:name="io.github.shoalapps.shoal" />
    </queries>

    <!-- Reading the Tintloom version's data once, after the rename. Signature-only: both apps share the release key. -->
    <permission
        android:name="io.github.shoalapps.permission.MOVE_DATA"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.shoalapps.permission.MOVE_DATA" />
    <queries>
        <provider android:authorities="io.github.tintloom.clips.movedata" />
        <provider android:authorities="io.github.tintloom.clips.debug.movedata" />
        <package android:name="io.github.tintloom.clips" />
    </queries>

    <!-- Accounts from Shoal (signature-protected). -->
    <uses-permission android:name="io.github.shoalapps.permission.ACCOUNTS" />
    <queries>
        <provider android:authorities="io.github.shoalapps.shoal.accounts" />
        <provider android:authorities="io.github.shoalapps.shoal.debug.accounts" />
    </queries>

    <application
        android:name=".TubeApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Tube"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".ClipsActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Short-video links from YouTube, TikTok and Instagram open here (one filter per site). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.youtube.com" />
                <data android:host="youtube.com" />
                <data android:pathPrefix="/shorts/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.tiktok.com" />
                <data android:host="vm.tiktok.com" />
                <data android:host="vt.tiktok.com" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.instagram.com" />
                <data android:host="instagram.com" />
                <data android:pathPrefix="/reel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
